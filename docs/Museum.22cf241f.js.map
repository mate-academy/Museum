'use strict';
document.addEventListener('DOMContentLoaded', function() {
    var opacityHover = function opacityHover(className) {
        if (desktop === 1) {
            var selectorList = document.querySelectorAll(className);
            selectorList.forEach(function(element) {
                element.addEventListener('mouseover', function() {
                    selectorList.forEach(function(i) {
                        i.style.opacity = 0.5;
                        i.style.zIndex = 1;
                    });
                    element.style.opacity = 1;
                    element.style.zIndex = 3;
                // console.log(element);
                });
                element.addEventListener('mouseleave', function() {
                    selectorList.forEach(function(i) {
                        return i.style.opacity = 1;
                    });
                });
            });
        }
    };
    var img = document.querySelectorAll('.galery__wrapper');
    var scrollContainer = document.querySelector('.galery__images');
    var bottomSlider = document.querySelector('.galery__bottom-slider');
    var desktop = document.documentElement.clientWidth >= 1280 ? 1 : 2;
    var currentIndex = 0;
    var widthScroll = img[0].clientWidth + 0;
    var phoneOrTablet = 1;
    var indexElemet;
    if (document.documentElement.clientWidth >= 640) {
        widthScroll = img[0].offsetWidth + 20;
        phoneOrTablet = 2;
    }
    for(var countButton = 0; countButton < img.length - phoneOrTablet; countButton++){
        var newElement = document.createElement('button');
        newElement.classList.add('galery__button');
        bottomSlider.appendChild(newElement);
    }
    var swipe = function() {
        scrollContainer.scrollTo({
            left: widthScroll * currentIndex,
            behavior: 'smooth'
        });
    };
    var button = document.querySelectorAll('.galery__button');
    scrollContainer.addEventListener('scroll', function() {
        indexElemet = Math.round(scrollContainer.scrollLeft / widthScroll);
        button.forEach(function(b) {
            return b.classList.remove('active');
        });
        button[indexElemet].classList.add('active');
    });
    opacityHover('.galery__wrapper');
    opacityHover('.nav__link');
    opacityHover('.footer__link');
    button.forEach(function(btn, index) {
        btn.addEventListener('click', function() {
            currentIndex = index;
            swipe();
        });
    });
    var form = document.querySelector('.subscriptions__form');
    form.addEventListener('submit', function(e) {
        form.reset();
    });
});

