{
  "name": "gulp-boilerplate",
  "version": "1.0.0",
  "description": "Frontend boilerplate based on gulp",
  "scripts": {
    "init": "mate-scripts init",
    "start": "npx parcel src/index.html",
    "style-format": "npx stylelint 'src/**/*.scss' --fix --allow-empty-input",
    "format": "prettier --ignore-path .prettierignore --write './src/**/*.{html,css,scss}'",
    "lint": "npm run style-format && npm run format && mate-scripts lint",
    "test:only": "mate-scripts test",
    "build": "mate-scripts build",
    "deploy": "cross-env NODE_ENV=production npx parcel build src/index.html --out-dir dist --public-url ./",
    "update": "mate-scripts update",
    "postinstall": "npm run update",
    "test": "npm run lint && npm run test:only",
    "lint:css": "stylelint 'src/styles/**/*.scss'",
    "lint:css:fix": "stylelint 'src/styles/**/*.scss' --fix"
  },
  "keywords": [],
  "author": "Mate Academy",
  "license": "GPL-3.0",
  "devDependencies": {
    "@linthtml/linthtml": "^0.9.6",
    "@mate-academy/bemlint": "latest",
    "@mate-academy/linthtml-config": "latest",
    "@mate-academy/scripts": "^2.1.1",
    "@mate-academy/stylelint-config": "latest",
    "@parcel/transformer-sass": "^2.12.0",
    "cssnano": "^4.1.11",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "postcss": "^8.5.6",
    "postcss-scss": "^4.0.9",
    "prettier": "^3.3.2",
    "stylelint": "^15.11.0",
    "stylelint-config-standard": "^39.0.0",
    "stylelint-config-standard-scss": "^8.0.0",
    "stylelint-scss": "^6.12.1"
  },
  "mateAcademy": {
    "projectType": "layout",
    "linters": {
      "javascript": false,
      "bem": false
    },
    "tests": {
      "backstop": false
    }
  }
}
