html {
  line-height: 1.15;
  -webkit-text-size-adjust: 100%;
}

main {
  display: block;
}

h1 {
  margin: 0.67em 0;
  font-size: 2em;
}

hr {
  overflow: visible;
  box-sizing: content-box;
  height: 0;
}

pre {
  font-family: monospace;
  font-size: 1em;
}

a {
  background-color: transparent;
}

abbr[title] {
  border-bottom: 0;
  text-decoration: underline;
  text-decoration: underline dotted;
}

b,
strong {
  font-weight: bolder;
}

code,
kbd,
samp {
  font-family: monospace;
  font-size: 1em;
}

small {
  font-size: 80%;
}

sub,
sup {
  position: relative;
  font-size: 75%;
  line-height: 0;
  vertical-align: baseline;
}

sub {
  bottom: -0.25em;
}

sup {
  top: -0.5em;
}

img {
  border-style: none;
}

button,
input,
optgroup,
select,
textarea {
  font-family: inherit;
  font-size: 100%;
  line-height: 1.15;
}

button,
input {
  overflow: visible;
}

button,
select {
  text-transform: none;
}

button,
[type=button],
[type=reset],
[type=submit] {
  -webkit-appearance: button;
}

button::-moz-focus-inner,
[type=button]::-moz-focus-inner,
[type=reset]::-moz-focus-inner,
[type=submit]::-moz-focus-inner {
  padding: 0;
  border-style: none;
}

button:-moz-focusring,
[type=button]:-moz-focusring,
[type=reset]:-moz-focusring,
[type=submit]:-moz-focusring {
  outline: 1px dotted ButtonText;
}

fieldset {
  padding: 0.35em 0.75em 0.63em;
}

legend {
  display: table;
  box-sizing: border-box;
  max-width: 100%;
  padding: 0;
  color: inherit;
  white-space: normal;
}

progress {
  vertical-align: baseline;
}

textarea {
  overflow: auto;
}

[type=checkbox],
[type=radio] {
  box-sizing: border-box;
  padding: 0;
}

[type=number]::-webkit-inner-spin-button,
[type=number]::-webkit-outer-spin-button {
  height: auto;
}

[type=search] {
  -webkit-appearance: textfield;
  outline-offset: -2px;
}

[type=search]::-webkit-search-decoration {
  -webkit-appearance: none;
}

::-webkit-file-upload-button {
  font: inherit;
  -webkit-appearance: button;
}

details {
  display: block;
}

summary {
  display: list-item;
}

template,
[hidden] {
  display: none;
}

*,
*::before,
*::after {
  box-sizing: border-box;
}

html,
body,
h1,
h2,
h3,
h4,
h5,
h6,
p,
ul,
ol,
figure,
blockquote,
dl,
dd {
  margin: 0;
}

ul,
ol {
  padding: 0;
  list-style: none;
}

body {
  min-height: 100vh;
}

a {
  color: inherit;
  text-decoration: none;
}

img,
picture,
svg,
video,
canvas {
  display: block;
  max-width: 100%;
}

button,
input,
textarea,
select {
  font: inherit;
}

.container {
  max-width: 1170px;
  padding-inline: 20px;
}
@media (min-width: 768px) {
  .container {
    padding-inline: 40px;
  }
}
@media (min-width: 1024px) {
  .container {
    padding-inline: 55px;
  }
}
.container {
  margin-inline: auto;
}

.section-title {
  font-family: Montserrat, sans-serif;
  font-weight: 700;
  font-size: 36px;
  line-height: 100%;
  color: rgb(15, 14, 8);
  text-align: center;
}

.page {
  font-family: IBM Plex Sans, sans-serif;
  font-size: 14px;
  font-weight: 400;
}
.page__body {
  min-height: 100vh;
  min-width: 320px;
  background-color: rgb(255, 255, 255);
}
.page__menu {
  position: fixed;
  z-index: 2;
  top: 0;
  left: 0;
  right: 0;
  pointer-events: none;
  opacity: 0;
  transform: translateY(-100%);
  box-shadow: 0 0 0 100vmax rgba(80, 80, 80, 0.45);
  transition: transform 500ms ease, opacity 500ms ease;
}
.page__menu:target {
  opacity: 1;
  transform: translateY(0);
  pointer-events: all;
}

.page:has(.page__menu:target) {
  overflow: hidden;
}

.header__wrapper {
  --columns: 2;
  display: grid;
  column-gap: 20px;
  grid-template-columns: repeat(var(--columns), 1fr);
}
@media (min-width: 768px) {
  .header__wrapper {
    --columns: 6;
    column-gap: 30px;
  }
}
@media (min-width: 1024px) {
  .header__wrapper {
    --columns: 12;
  }
}
.header__wrapper {
  gap: 20px;
  position: relative;
  margin-bottom: 70px;
}
@media (min-width: 768px) {
  .header__wrapper {
    margin-bottom: 88px;
  }
}
@media (min-width: 1024px) {
  .header__wrapper {
    margin-bottom: 200px;
  }
}
.header__top {
  display: grid;
  grid-template-columns: 1fr auto 1fr;
  grid-column: 1/-1;
  grid-row: 1;
  align-items: center;
  height: 80px;
  position: relative;
  z-index: 2;
  padding-top: 9px;
}
@media (min-width: 768px) {
  .header__top {
    grid-template-columns: 2fr auto 1fr;
  }
}
.header__image {
  grid-column: 1/-1;
  grid-row: 1;
  height: clamp(300px, 54.6875vw, 700px);
  background-image: url("/src/images/header/header-bg.png");
  background-position: center;
  background-repeat: no-repeat;
  background-size: cover;
  margin-inline: -20px;
}
@media (min-width: 768px) {
  .header__image {
    grid-column: 4/-1;
    margin-left: 0;
    margin-right: -40px;
  }
}
@media (min-width: 1024px) {
  .header__image {
    grid-column: 6/-1;
    margin-right: calc((min(100vw, 1170px) - 100vw) / 2 - 55px);
  }
}
.header__content {
  display: grid;
  text-align: center;
  align-items: center;
  grid-column: 1/-1;
  grid-row: 2;
  gap: 20px;
}
@media (min-width: 768px) {
  .header__content {
    grid-column: 1/4;
    grid-row: 1;
    align-self: center;
    text-align: left;
    margin-top: 127px;
    gap: 40px;
    grid-template-columns: subgrid;
  }
}
@media (min-width: 1024px) {
  .header__content {
    grid-column: 1/6;
    gap: 70px;
    margin-top: 206px;
  }
}
.header__logo {
  grid-column: 2;
  justify-self: center;
  width: 55px;
  height: 61px;
}
@media (min-width: 768px) {
  .header__logo {
    width: 170px;
    height: 72px;
  }
}
@media (min-width: 1024px) {
  .header__logo {
    width: 220px;
  }
}
.header__title {
  font-family: Montserrat, sans-serif;
  grid-column: 1/-1;
  font-weight: 700;
  font-size: 45px;
  line-height: 100%;
}
@media (min-width: 768px) {
  .header__title {
    grid-column: 1/4;
    font-size: 54px;
    line-height: 120%;
  }
}
@media (min-width: 1024px) {
  .header__title {
    grid-column: 1/6;
    font-size: 65px;
  }
}
.header__ticket {
  position: relative;
  display: flex;
  justify-content: center;
  align-items: center;
  height: 50px;
  border: 1px solid rgb(26, 90, 76);
}
@media (min-width: 768px) {
  .header__ticket {
    grid-column: 1/3;
    padding: 0 110px 0 70px;
  }
}
@media (min-width: 1024px) {
  .header__ticket {
    grid-column: 3/6;
  }
}
.header__ticket::after {
  content: ">";
  position: absolute;
  display: flex;
  width: 50px;
  right: 0;
  top: 0;
  bottom: 0;
  display: flex;
  background-color: rgb(26, 90, 76);
  color: rgb(215, 221, 227);
  font-size: 16px;
  font-weight: bold;
  justify-content: center;
  align-items: center;
}
.header__events {
  display: none;
}
@media (min-width: 1024px) {
  .header__events {
    position: absolute;
    left: 0;
    bottom: -15px;
    display: flex;
    flex-direction: row-reverse;
    align-items: center;
    gap: 20px;
    writing-mode: vertical-rl;
    transform: rotate(180deg);
    color: rgb(104, 116, 128);
    font-weight: 700;
    line-height: 100%;
  }
  .header__events::after {
    content: "";
    display: block;
    width: 1px;
    height: 70px;
    background-color: rgb(104, 116, 128);
  }
}

.icon {
  appearance: none;
  display: block;
  width: 24px;
  height: 24px;
  padding: 0;
  border: 0;
  background-color: transparent;
  background-repeat: no-repeat;
  background-position: center;
  background-size: cover;
  cursor: pointer;
}
.icon--menu {
  background-image: url("../images/icons/burger.png");
  grid-column: 1;
  justify-self: start;
}
.icon--close {
  background-image: url("../images/icons/Vector.png");
}

.menu {
  overflow-y: auto;
  background-color: rgb(26, 90, 76);
  padding-block: 27px;
  min-height: 400px;
}
@media (min-width: 768px) {
  .menu {
    min-height: 225px;
  }
}
.menu__wrapper {
  --columns: 2;
  display: grid;
  column-gap: 20px;
  grid-template-columns: repeat(var(--columns), 1fr);
}
@media (min-width: 768px) {
  .menu__wrapper {
    --columns: 6;
    column-gap: 30px;
  }
}
@media (min-width: 1024px) {
  .menu__wrapper {
    --columns: 12;
  }
}
.menu__nav {
  display: grid;
  grid-column: 1/-1;
  grid-template-columns: 28px minmax(0, 1fr);
  column-gap: 28px;
  margin-bottom: 24px;
  height: 100%;
}
@media (min-width: 768px) {
  .menu__nav {
    grid-template-columns: 38px minmax(0, 1fr);
    grid-column: 1/4;
    margin-bottom: 0;
  }
}
@media (min-width: 1024px) {
  .menu__nav {
    grid-column: 1/7;
  }
}
.menu__nav::after {
  content: "";
  display: block;
  grid-column: 1/-1;
  height: 1px;
  background-color: rgba(255, 255, 255, 0.5);
  margin-top: 24px;
}
@media (min-width: 768px) {
  .menu__nav::after {
    grid-column: 3;
    grid-row: 1;
    width: 2px;
    height: auto;
    margin-top: 0;
  }
}
@media (prefers-reduced-motion: reduce) {
  .menu .page__menu {
    transition: none;
  }
}
.menu__graph {
  display: grid;
  grid-column: 1/-1;
  gap: 20px;
}
@media (min-width: 768px) {
  .menu__graph {
    grid-template-columns: repeat(2, minmax(0, 1fr));
    grid-column: 4/-1;
    gap: 28px;
  }
}
@media (min-width: 1024px) {
  .menu__graph {
    grid-template-columns: repeat(5, minmax(0, 1fr));
    grid-column: 7/-1;
    gap: 30px;
  }
}
.menu__title {
  color: rgb(255, 255, 255);
  line-height: 141%;
  font-weight: 400;
}
@media (min-width: 768px) {
  .menu__title {
    grid-column: 1;
  }
}
.menu__time {
  font-weight: 600;
  line-height: 150%;
  color: rgb(255, 255, 255);
}
.menu__day {
  color: rgb(255, 255, 255);
  font-weight: 400;
  line-height: 150%;
}
.menu__schedule {
  width: max-content;
  border-spacing: 8px 0;
  margin-left: -8px;
}
@media (min-width: 768px) {
  .menu__schedule {
    grid-column: 1;
    align-self: end;
  }
}
.menu__descr {
  color: rgb(255, 255, 255);
  font-weight: 400;
  line-height: 150%;
}
@media (min-width: 768px) {
  .menu__descr {
    grid-column: 2;
    grid-row: 1/span 2;
    align-self: end;
  }
}
@media (min-width: 1024px) {
  .menu__descr {
    align-self: center;
    grid-column: 3/span 2;
  }
}

.nav__list {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 24px 28px;
}
.nav__link {
  font-weight: 500;
  font-size: 16px;
  line-height: 100%;
  color: rgb(255, 255, 255);
}

.events {
  grid-column: 1/-1;
}
.events__wrapper {
  --columns: 2;
  display: grid;
  column-gap: 20px;
  grid-template-columns: repeat(var(--columns), 1fr);
}
@media (min-width: 768px) {
  .events__wrapper {
    --columns: 6;
    column-gap: 30px;
  }
}
@media (min-width: 1024px) {
  .events__wrapper {
    --columns: 12;
  }
}
.events__item {
  grid-column: 1/-1;
  margin-bottom: 60px;
}
.events__title {
  grid-column: 1/-1;
  margin-bottom: 40px;
}
.events__picture {
  grid-column: 1/-1;
  margin-bottom: 20px;
}
.events__image {
  display: block;
  height: 100%;
}
.events__picture-full {
  margin-right: -20px;
  margin-left: -20px;
  margin-bottom: 0;
  height: 210px;
  overflow: hidden;
}
.events__info {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 15px;
}
.events__content {
  position: relative;
  z-index: 1;
  margin-top: -50px;
  padding: 20px;
  background-color: rgb(255, 255, 255);
}
.events__name {
  font-weight: 500;
  font-size: 16px;
  color: rgb(104, 116, 128);
  line-height: 100%;
}
.events__date {
  font-weight: 500;
  font-size: 16px;
  font-weight: 700;
  color: rgb(26, 90, 76);
  line-height: 150%;
  margin-bottom: 15px;
  white-space: nowrap;
  margin: 0;
}
.events__heading-left {
  grid-column: 1/-1;
  font-family: Montserrat, sans-serif;
  text-align: left;
  font-weight: 400;
  font-size: 28px;
  margin-bottom: 10px;
}
.events__heading-left::after {
  content: "";
  display: inline-block;
  margin-left: 10px;
  vertical-align: middle;
  width: 10px;
  height: 10px;
  background-color: rgb(241, 74, 39);
}
.events__heading-center {
  grid-column: 1/-1;
  font-family: Montserrat, sans-serif;
  text-align: center;
  font-weight: 400;
  font-size: 28px;
  margin-bottom: 10px;
}
.events__descr {
  grid-column: 1/-1;
  font-weight: 300;
  font-size: 16px;
  line-height: 150%;
  color: rgb(78, 78, 78);
}

.main__content {
  display: grid;
  row-gap: 60px;
}
